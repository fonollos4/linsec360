// Managed by LinSec360 / patching_option2. Local changes will be overwritten.
Unattended-Upgrade::Allowed-Origins {
{% if ansible_distribution == 'Ubuntu' %}
    "${distro_id}:${distro_codename}-security";
    "${distro_id}ESMApps:${distro_codename}-apps-security";
{% else %}
    "origin=Debian,codename=${distro_codename},label=Debian-Security";
{% endif %}
};

Unattended-Upgrade::Remove-Unused-Dependencies "true";
// No forced reboot during working hours: reboots stay manual unless the
// operator explicitly opts in with an out-of-hours time.
Unattended-Upgrade::Automatic-Reboot "{{ 'true' if patching_automatic_reboot | bool else 'false' }}";
{% if patching_automatic_reboot | bool %}
Unattended-Upgrade::Automatic-Reboot-Time "{{ patching_reboot_time }}";
{% endif %}
