# LinSec360 deployment environment template
# Copy this file to .env, keep it private (chmod 600), and fill every required
# value. Use single quotes around values containing $, #, spaces, or special
# characters. Never commit .env.

# ---------------------------------------------------------------------------
# Required application secrets
# ---------------------------------------------------------------------------
# Generate LINSEC_SECRET_KEY with: openssl rand -hex 32
LINSEC_SECRET_KEY=
# Required in production. Generate with: openssl rand -base64 32 | tr '+/' '-_'
# Keep it stable and back it up separately; losing it makes stored host passwords unrecoverable.
# Do not rotate it while encrypted host passwords exist.
LINSEC_CREDENTIAL_ENCRYPTION_KEY=
LINSEC_BOOTSTRAP_ADMIN_USERNAME=admin
LINSEC_BOOTSTRAP_ADMIN_PASSWORD=
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Application runtime
# ---------------------------------------------------------------------------
LINSEC_ENVIRONMENT=development
LINSEC_COOKIE_SECURE=false
LINSEC_CORS_ORIGINS=["http://localhost:5173","http://localhost"]
LINSEC_API_PORT=8080
LINSEC_WEB_PORT=80
LINSEC_HTTPS_PORT=8444
# Comma-separated DNS names/IPs included in a generated TLS certificate.
LINSEC_TLS_HOSTS=localhost,127.0.0.1
# TLS may use a generated self-signed certificate for testing; use a trusted certificate in production.
LINSEC_TLS_ENABLED=false
LINSEC_UID=1000
LINSEC_GID=1000
LINSEC_LOG_API_TOKEN=
# Keep a private key on the host; the API and worker mount this directory read-only.
LINSEC_SSH_KEY_DIR=./.ssh
LINSEC_ANSIBLE_SSH_PRIVATE_KEY_PATH=/opt/linsec/.ssh/id_ed25519

# Optional backend configuration
LINSEC_DEPLOYMENT_MAX_PER_ENVIRONMENT=1
LINSEC_DEPLOYMENT_TIMEOUT_SECONDS=1800
LINSEC_DEPLOYMENT_RETENTION_DAYS=365
LINSEC_SESSION_TTL_MINUTES=480

# Optional filesystem layout. The defaults below match the container image and
# only need to be overridden for bare-metal or custom mounts.
# LINSEC_CONFIG_DIR=/opt/linsec/config
# LINSEC_ARTIFACT_DIR=/opt/linsec/var/artifacts
# LINSEC_OPENSCAP_PROFILE_DIR=/opt/linsec/config/openscap/profiles
# LINSEC_HARDENING_BASELINE_PATH=/opt/linsec/config/hardening/baseline.yml
# ANSIBLE_CONFIG=/etc/ansible/ansible.cfg

# ---------------------------------------------------------------------------
# Wazuh passwords and bcrypt hashes
# ---------------------------------------------------------------------------
# Instead of filling these manually, run:
#   python3 config/scripts/init-wazuh-env.py
WAZUH_ADMIN_PASSWORD=
WAZUH_ADMIN_PASSWORD_HASH=
WAZUH_DASHBOARD_PASSWORD=
WAZUH_DASHBOARD_PASSWORD_HASH=
WAZUH_API_USERNAME=wazuh-wui
WAZUH_API_PASSWORD=
WAZUH_INDEXER_USERNAME=admin

# Wazuh endpoints and exposed ports
# Optional external agent address; otherwise LinSec derives it from the API URL
# when that hostname is not the Docker-internal wazuh.manager alias.
LINSEC_WAZUH_MANAGER_ADDRESS=
LINSEC_WAZUH_API_URL=https://wazuh.manager:55000
LINSEC_WAZUH_DASHBOARD_URL=https://wazuh.dashboard:5601
LINSEC_WAZUH_API_VERIFY_TLS=true
LINSEC_WAZUH_INDEXER_URL=https://wazuh.indexer:9200
LINSEC_WAZUH_INDEXER_VERIFY_TLS=true
WAZUH_MANAGER_PORT=1514
WAZUH_MANAGER_ENROLLMENT_PORT=1515
WAZUH_SYSLOG_PORT=514
WAZUH_API_PORT=55000
WAZUH_INDEXER_PORT=9200
WAZUH_DASHBOARD_PORT=443

# ---------------------------------------------------------------------------
# Uyuni patch integration (optional)
# ---------------------------------------------------------------------------
# Use this internal endpoint when Uyuni is started with the Compose uyuni profile.
LINSEC_UYUNI_API_URL=http://uyuni/rpc/api
LINSEC_UYUNI_USERNAME=admin
# Generate a separate secret for a production Uyuni administrator.
LINSEC_UYUNI_PASSWORD=
LINSEC_UYUNI_VERIFY_TLS=true
LINSEC_UYUNI_TIMEOUT_SECONDS=30

# Uyuni container deployment (only with --profile uyuni)
# These values configure the official Uyuni server and database containers.
UYUNI_FQDN=uyuni
UYUNI_TIMEZONE=Etc/UTC
UYUNI_ADMIN_USERNAME=admin
# Use a strong unique password and keep it identical to LINSEC_UYUNI_PASSWORD.
UYUNI_ADMIN_PASSWORD=
UYUNI_ADMIN_EMAIL=admin@uyuni.local
UYUNI_MAIL_FROM=admin@uyuni.local
UYUNI_POSTGRES_USER=postgres
# Generate unique database credentials with: openssl rand -hex 16 (32 characters).
UYUNI_POSTGRES_PASSWORD=
UYUNI_DB_USERNAME=uyuni
UYUNI_DB_PASSWORD=
UYUNI_REPORT_DB_USERNAME=reportdb
UYUNI_REPORT_DB_PASSWORD=
UYUNI_POD_NETWORK=172.30.0.0/16
UYUNI_HTTP_PORT=8081
UYUNI_HTTPS_PORT=8443
UYUNI_SALT_PUBLISH_PORT=4505
UYUNI_SALT_REQUEST_PORT=4506

# ---------------------------------------------------------------------------
# Legacy Flask/Wazuh stack compatibility
# ---------------------------------------------------------------------------
FLASK_SECRET=
